<script>
(function(){
  var $=function(id){return document.getElementById(id)};
  var arc=$('esc-arc');if(!arc||!arc.getTotalLength)return;
  var AL=arc.getTotalLength();
  var P={buyer:$('p-buyer'),escrow:$('p-escrow'),seller:$('p-seller')};
  var T={doc:$('t-doc'),parcel:$('t-parcel'),coin:$('t-coin')};
  var POS={buyer:[102,82],vault:[260,105],seller:[418,82]};
  // each step: when, sys, msg, pill, chips [buyer,escrow,seller], on (active parties), anim, held, tone
  function runs(){
    var common=[
      {when:'Day 1 · 10:02',sys:'TrustBee',msg:'Seller sends a conditional payment request to the buyer',pill:'Request sent',chips:['Request received','Empty','Request sent'],on:['seller','buyer'],anim:'request'},
      {when:'Day 1 · 10:05',sys:'Verification',msg:'Buyer and seller verified with NID and fraud checks',pill:'Verified',chips:['Verified','Empty','Verified'],on:['buyer','seller'],anim:'verify'},
      {when:'Day 1 · 10:09',sys:'Payment gateway',msg:'Buyer pays AMT through the licensed payment gateway',pill:'Payment received',chips:['Paid','Receiving','Verified'],on:['buyer','escrow'],anim:'pay'},
      {when:'Day 1 · 10:09',sys:'Escrow',msg:'Funds locked in escrow. Seller is notified to start work',pill:'Funds held',chips:['Paid','Locked','Start work'],on:['escrow','seller'],anim:'lock'},
      {when:'Day 4 · 16:40',sys:'Seller app',msg:'Seller delivers and uploads proof of delivery',pill:'Delivered',chips:['Reviewing','Locked','Delivered'],on:['seller','buyer'],anim:'deliver'}
    ];
    var tail=[
      {when:'Day 6 · 11:30',sys:'Payout service',msg:'Funds released to the seller’s bank or mobile wallet',pill:'Released',chips:['Confirmed','Releasing','Payout'],on:['escrow','seller'],anim:'release'},
      {when:'Day 6 · 11:31',sys:'Notifications',msg:'Receipts sent to both parties by SMS and email',pill:'Completed',chips:['Completed','Closed','Paid out'],on:[],anim:'done'}
    ];
    var smooth=common.concat([
      {when:'Day 5 · 09:15',sys:'Buyer app',msg:'Buyer checks the work and confirms delivery',pill:'Confirmed',chips:['Confirmed','Locked','Delivered'],on:['buyer'],anim:'confirm'}
    ],tail);
    var dispute=common.concat([
      {when:'Day 4 · 19:05',sys:'Dispute desk',msg:'Buyer raises a dispute: two items don’t match the order',pill:'Disputed',chips:['Disputed','On hold','Notified'],on:['buyer'],anim:'dispute',tone:'warn'},
      {when:'Day 5 · 12:20',sys:'Mediation',msg:'Neutral mediator reviews evidence. Funds stay locked',pill:'Under review',chips:['Evidence sent','Under review','Evidence sent'],on:['escrow'],anim:'review',tone:'warn'},
      {when:'Day 6 · 15:45',sys:'Seller app',msg:'Seller replaces the items as agreed in mediation',pill:'Re-delivered',chips:['Reviewing','Locked','Re-delivered'],on:['seller','buyer'],anim:'redeliver'},
      {when:'Day 7 · 10:10',sys:'Buyer app',msg:'Buyer confirms delivery and closes the dispute',pill:'Confirmed',chips:['Confirmed','Locked','Delivered'],on:['buyer'],anim:'confirm'}
    ],tail.map(function(s){var c=Object.assign({},s);c.when=c.when.replace('Day 6','Day 7');return c}));
    return [
      {id:'#ESC-30517',amt:'৳25,000',deal:'Website design project',steps:smooth},
      {id:'#ESC-30518',amt:'৳48,500',deal:'Wholesale garments order',steps:dispute}
    ];
  }
  var RUNS=runs();
  function lerp(a,b,t){return [a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t]}
  function ease(x){return x<.5?2*x*x:1-Math.pow(-2*x+2,2)/2}
  function put(el,p,show){el.setAttribute('transform','translate('+p[0].toFixed(1)+' '+p[1].toFixed(1)+')');el.classList.toggle('show',!!show)}
  function onArc(t){var q=arc.getPointAtLength(AL*t);return [q.x,q.y]}
  // derived per-step state
  function stateFor(run,i){
    var s=run.steps[i],a=s.anim,idx=run.steps.findIndex(function(x){return x.anim==='pay'});
    return {
      verified:i>=1,
      held:i>=idx&&a!=='release'&&a!=='done'?(a==='pay'?'Receiving '+run.amt:run.amt+' held'):(a==='release'?'Releasing '+run.amt:(a==='done'?'৳0 held':'৳0 held')),
      locked:i>idx&&a!=='release'&&a!=='done',
      buyerWarn:a==='dispute'||a==='review',
      vaultWarn:a==='review'||a==='dispute',
      done:a==='done'
    };
  }
  var log=$('flow-log'),ev=document.querySelector('.flow-event'),pill=$('flow-pill');
  function enter(run,i,withLog){
    var s=run.steps[i],st=stateFor(run,i),n=run.steps.length;
    $('esc-id').textContent=run.id;$('esc-amt').textContent=run.amt;$('esc-deal').textContent=run.deal;
    $('flow-sys').textContent=s.sys;$('flow-msg').textContent=s.msg.replace('AMT',run.amt);$('flow-status').textContent=s.pill;
    $('c-buyer').textContent=s.chips[0];$('c-escrow').textContent=s.chips[1];$('c-seller').textContent=s.chips[2];
    $('esc-held').textContent=st.held;
    $('flow-step').textContent='Step '+(i+1)+' of '+n;$('flow-bar').style.width=((i+1)/n*100)+'%';
    $('esc-safe').textContent=st.done?'Paid out':'Yes';
    ['buyer','escrow','seller'].forEach(function(k){
      var el=P[k];el.classList.toggle('on',s.on.indexOf(k)>-1&&!st.done);
      el.classList.toggle('done',st.done);
    });
    P.buyer.classList.toggle('ok',st.verified&&s.anim!=='dispute');P.seller.classList.toggle('ok',st.verified);
    P.buyer.classList.toggle('warn',st.buyerWarn&&s.anim==='dispute');
    P.escrow.classList.toggle('locked',st.locked);P.escrow.classList.toggle('warn',s.anim==='review');
    pill.classList.toggle('ok',st.done);pill.classList.toggle('warn',s.tone==='warn');
    ev.classList.toggle('warn',s.tone==='warn');
    ev.classList.remove('flash');void ev.offsetWidth;ev.classList.add('flash');
    if(withLog){
      var li=document.createElement('li');if(s.tone==='warn')li.className='w';
      li.innerHTML='<b></b><span></span>';li.firstChild.textContent=s.when;li.lastChild.textContent=s.sys+' · '+s.msg.replace('AMT',run.amt);
      log.insertBefore(li,log.firstChild);while(log.children.length>3)log.removeChild(log.lastChild);
    }
  }
  function tokens(run,i,p){
    var a=run.steps[i].anim,k=ease(Math.min(1,p));
    var payIdx=run.steps.findIndex(function(x){return x.anim==='pay'});
    // doc
    put(T.doc,onArc(k),a==='request'&&p<1);
    // parcel
    var del=a==='deliver'||a==='redeliver';
    put(T.parcel,onArc(del?k:1),del&&p<1.15);
    // coin
    var c,show=true;
    if(i<payIdx)c=POS.buyer;
    else if(a==='pay')c=lerp(POS.buyer,POS.vault,k);
    else if(a==='release')c=lerp(POS.vault,POS.seller,k);
    else if(a==='done')c=POS.seller;
    else c=POS.vault;
    if(i===0)show=p>.6;
    put(T.coin,c,show);
  }
  var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce){var r=RUNS[0],last=r.steps.length-1;enter(r,last,true);tokens(r,last,1);return}
  var MOVE=1300,STEP=2600,GAP=1800;
  var ri=0,si=-1,t0=null;
  function frame(ts){
    if(t0===null)t0=ts;
    var run=RUNS[ri],n=run.steps.length,t=ts-t0,i=Math.floor(t/STEP);
    if(i>=n){if(t>n*STEP+GAP){ri=(ri+1)%RUNS.length;si=-1;t0=ts;log.innerHTML='';}requestAnimationFrame(frame);return}
    if(i!==si){si=i;enter(run,i,true)}
    tokens(run,i,(t-i*STEP)/MOVE);
    requestAnimationFrame(frame);
  }
  enter(RUNS[0],0,false);tokens(RUNS[0],0,0);
  requestAnimationFrame(frame);
})();

document.querySelectorAll('.copy').forEach(function(b){
  b.addEventListener('click',function(){
    var el=document.getElementById(b.dataset.copy), t=el.textContent.trim();
    function done(){b.textContent='Copied';setTimeout(function(){b.textContent='Copy'},1600)}
    function fallback(){var r=document.createRange();r.selectNodeContents(el);var s=getSelection();s.removeAllRanges();s.addRange(r);b.textContent='Selected'}
    try{navigator.clipboard.writeText(t).then(done,fallback)}catch(e){fallback()}
  });
});
document.getElementById('enquiry').addEventListener('submit',function(e){
  e.preventDefault();
  var v=function(id){return document.getElementById(id).value.trim()};
  var note=document.getElementById('formnote');
  if(!v('f-name')||!/.+@.+\..+/.test(v('f-email'))){note.textContent='Please add your name and a valid email address.';note.hidden=false;return}
  var subject='Website enquiry: '+v('f-topic')+' ('+v('f-name')+')';
  var lines=['Name: '+v('f-name'),'Company: '+v('f-company'),'Email: '+v('f-email'),'Phone: '+v('f-phone'),'Service: '+v('f-topic'),'','Message:',v('f-msg')];
  window.location.href='mailto:care@e-xpertconsultants.com?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(lines.join('\n'));
  note.textContent='Your email app should open with the enquiry ready to send. If it does not, email care@e-xpertconsultants.com or call +880 1332-092905.';
  note.hidden=false;
});
(function(){
  var NS='http://www.w3.org/2000/svg',path=document.getElementById('inf-path');
  if(!path||!path.getTotalLength)return;
  var L=path.getTotalLength();
  var runner=document.getElementById('inf-runner'),g=document.getElementById('inf-marks'),sg=document.getElementById('inf-sparks');
  var trails=[['.inf-t1',90],['.inf-glow',90],['.inf-t2',190],['.inf-t3',320]].map(function(t){var e=document.querySelector(t[0]);e.style.strokeDasharray=t[1]+' '+(L*2);return {e:e,len:t[1]}});
  var items=document.querySelectorAll('#stages li');
  items.forEach(function(li){if(!li.querySelector('.prog')){var p=document.createElement('span');p.className='prog';li.appendChild(p)}});
  var icons={
    Analyze:'<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5 5"/>',
    Solve:'<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z"/>',
    Automate:'<g class="gear"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1"/></g>',
    Grow:'<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>'
  };
  var pts=[[150,92,'Analyze',36],[150,238,'Solve',306],[410,92,'Automate',36],[410,238,'Grow',306]];
  function near(x,y){var best=0,bd=1e9;for(var s=0;s<=L;s+=1){var q=path.getPointAtLength(s),d=(q.x-x)*(q.x-x)+(q.y-y)*(q.y-y);if(d<bd){bd=d;best=s}}return best}
  var marks=pts.map(function(p){
    var s=near(p[0],p[1]),q=path.getPointAtLength(s),x=q.x.toFixed(1),y=q.y.toFixed(1),m=document.createElementNS(NS,'g');
    m.setAttribute('class','mk');
    m.innerHTML='<circle class="rip" cx="'+x+'" cy="'+y+'" r="26"/><circle class="rip r2" cx="'+x+'" cy="'+y+'" r="26"/>'+
      '<g class="pop"><circle class="disc" cx="'+x+'" cy="'+y+'" r="26"/><g class="ic" transform="translate('+(q.x-12).toFixed(1)+' '+(q.y-12).toFixed(1)+')">'+icons[p[2]]+'</g></g>'+
      '<text class="ml" x="'+x+'" y="'+p[3]+'">'+p[2]+'</text>';
    g.appendChild(m);return {s:s,el:m};
  });
  // spark pool
  var sparks=[];for(var i=0;i<22;i++){var c=document.createElementNS(NS,'circle');c.setAttribute('class','spk');c.setAttribute('r','0');sg.appendChild(c);sparks.push({el:c,life:0})}
  var si=0;
  function emit(x,y,n){for(var k=0;k<n;k++){var s=sparks[si++%sparks.length];var a=Math.random()*Math.PI*2,v=0.6+Math.random()*1.6;s.x=x;s.y=y;s.vx=Math.cos(a)*v;s.vy=Math.sin(a)*v;s.life=1;s.r=1.5+Math.random()*2.5}}
  function stepSparks(dt){sparks.forEach(function(s){if(s.life<=0)return;s.life-=dt/700;s.x+=s.vx*dt/16;s.y+=s.vy*dt/16;s.el.setAttribute('cx',s.x.toFixed(1));s.el.setAttribute('cy',s.y.toFixed(1));s.el.setAttribute('r',Math.max(0,s.r*s.life).toFixed(2));s.el.style.opacity=Math.max(0,s.life)})}
  var active=-1;
  function activate(a,dur){
    if(a===active)return;active=a;
    marks.forEach(function(m,i){m.el.classList.toggle('on',i===a);m.el.classList.remove('hit')});
    void marks[a].el.getBoundingClientRect();marks[a].el.classList.add('hit');
    items.forEach(function(li,i){li.classList.toggle('on',i===a);var p=li.querySelector('.prog');p.style.transition='none';p.style.width='0';
      if(i===a&&dur){void p.offsetWidth;p.style.transition='width '+dur+'ms linear';p.style.width='100%'}});
    var q=path.getPointAtLength(marks[a].s);emit(q.x,q.y,14);
  }
  function place(pos){
    var q=path.getPointAtLength(pos);runner.setAttribute('transform','translate('+q.x.toFixed(1)+' '+q.y.toFixed(1)+')');
    trails.forEach(function(t){t.e.style.strokeDashoffset=(t.len-pos).toFixed(1);});
    return q;
  }
  var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce){place(marks[0].s+40);activate(0,0);return}
  // move with a soft pause at each stage
  var SPEED=L/11000,PAUSE=900;
  var seq=marks.map(function(m,i){var next=i<3?marks[i+1].s:marks[0].s+L;return {from:m.s,to:next,i:i}});
  var cycle=seq.reduce(function(a,s){return a+PAUSE+(s.to-s.from)/SPEED},0);
  var t0=null,last=null,frameN=0;
  function ease(x){return x<.5?4*x*x*x:1-Math.pow(-2*x+2,3)/2}
  function frame(ts){
    if(t0===null){t0=ts;last=ts}
    var dt=Math.min(50,ts-last);last=ts;
    var t=(ts-t0)%cycle,acc=0;
    for(var k=0;k<4;k++){var s=seq[k],mv=(s.to-s.from)/SPEED,span=PAUSE+mv;
      if(t<acc+span){var lt=t-acc;
        activate(s.i,span);
        var pos=lt<PAUSE?s.from:s.from+(s.to-s.from)*ease((lt-PAUSE)/mv);
        var q=place(pos%L);
        if(lt>=PAUSE&&(frameN++%3===0))emit(q.x,q.y,1);
        break}
      acc+=span}
    stepSparks(dt);
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();


(function(){
  var svg=document.querySelector('.g-svg');if(!svg)return;
  var NS='http://www.w3.org/2000/svg',X0=60,X1=960,Y0=270,Y1=40,VMAX=120;
  var v=[8,9,11,14,18,23,30,38,48,60,74,90,110];
  function x(m){return X0+(X1-X0)*m/12}function y(val){return Y0-(Y0-Y1)*val/VMAX}
  function $(id){return document.getElementById(id)}
  // grid + axis
  var grid=$('g-grid');
  [0,30,60,90,120].forEach(function(g){var l=document.createElementNS(NS,'line');l.setAttribute('class','g-gl');l.setAttribute('x1',X0);l.setAttribute('x2',X1);l.setAttribute('y1',y(g));l.setAttribute('y2',y(g));grid.appendChild(l)});
  for(var m=0;m<=12;m+=2){var t=document.createElementNS(NS,'text');t.setAttribute('class','g-ax');t.setAttribute('x',x(m));t.setAttribute('y',Y0+18);t.textContent='M'+m;grid.appendChild(t)}
  // smooth curve (Catmull-Rom to Bezier)
  var P=v.map(function(val,i){return [x(i),y(val)]});
  var d='M'+P[0][0]+' '+P[0][1];
  for(var i=0;i<P.length-1;i++){var p0=P[i-1]||P[i],p1=P[i],p2=P[i+1],p3=P[i+2]||p2;
    d+=' C'+(p1[0]+(p2[0]-p0[0])/6).toFixed(1)+' '+(p1[1]+(p2[1]-p0[1])/6).toFixed(1)+' '+(p2[0]-(p3[0]-p1[0])/6).toFixed(1)+' '+(p2[1]-(p3[1]-p1[1])/6).toFixed(1)+' '+p2[0]+' '+p2[1]}
  $('g-line').setAttribute('d',d);
  $('g-area').setAttribute('d',d+' L'+X1+' '+Y0+' L'+X0+' '+Y0+' Z');
  var line=$('g-line'),L=line.getTotalLength();
  // phases on the curve
  var phases=[[1,'Research & analysis',150,'#0B4A93'],[3,'Product development',212,'#0E5DB8'],[5,'Branding & PR',168,'#3B6FE0'],[7,'Marketing & sales',138,'#1584F7'],[10,'Automation',72,'#1E7FD9']];
  var pg=$('g-phases');
  var ph=phases.map(function(p){
    var g=document.createElementNS(NS,'g');g.setAttribute('class','ph');g.style.setProperty('--pc',p[3]);
    var px=x(p[0]),py=y(v[p[0]]),ty=p[2];
    g.innerHTML='<line x1="'+px+'" x2="'+px+'" y1="'+(ty+8)+'" y2="'+(py-9)+'"/><circle cx="'+px+'" cy="'+py+'" r="7"/><text x="'+px+'" y="'+ty+'">'+p[1]+'</text>';
    pg.appendChild(g);return {m:p[0],el:g};
  });
  var clip=$('g-cliprect'),dot=$('g-dot'),pm=$('g-pmfill'),mo=$('g-month');
  function render(f){ // f: 0..1 progress in months
    var mx=X0+(X1-X0)*f;
    clip.setAttribute('width',mx);
    // find point on line at x=mx
    var lo=0,hi=L;for(var k=0;k<22;k++){var mid=(lo+hi)/2;if(line.getPointAtLength(mid).x<mx)lo=mid;else hi=mid}
    var q=line.getPointAtLength(lo);dot.setAttribute('cx',q.x.toFixed(1));dot.setAttribute('cy',q.y.toFixed(1));
    pm.setAttribute('width',Math.max(22,(X1-X0)*f));
    var month=Math.round(f*12);mo.textContent=month;
    ph.forEach(function(p){p.el.classList.toggle('on',f*12>=p.m-0.05)});
  }
  render(1);
  if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  var DRAW=6000,HOLD=2500,running=false,t0=null;
  function ease(t){return 1-Math.pow(1-t,2.2)}
  function frame(ts){
    if(t0===null)t0=ts;var t=(ts-t0)%(DRAW+HOLD);
    render(t<DRAW?ease(t/DRAW):1);
    if(running)requestAnimationFrame(frame);
  }
  var box=$('growth');
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(es){es.forEach(function(e){
      if(e.isIntersecting&&!running){running=true;t0=null;requestAnimationFrame(frame)}
      else if(!e.isIntersecting){running=false}
    })},{threshold:.35}).observe(box);
  }else{running=true;requestAnimationFrame(frame)}
})();

(function(){
  var cards=document.querySelectorAll('.svc');
  if(!('IntersectionObserver' in window)){cards.forEach(function(c){c.classList.add('play')});return}
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('play');io.unobserve(e.target)}})},{threshold:.3});
  cards.forEach(function(c){io.observe(c)});
})();

(function(){
  var cards=[].slice.call(document.querySelectorAll('.field'));
  var items=cards.map(function(c,i){return {c:c,lis:c.querySelectorAll('.proc li'),row:c.querySelector('.proc-row'),off:i*650,vis:false,last:-1}});
  function set(it,p){
    it.row.style.setProperty('--p',p.toFixed(3));
    var n=it.lis.length,reached=Math.floor(p*(n-1)+1e-6);
    it.lis.forEach(function(li,k){li.classList.toggle('on',k<=reached);li.classList.toggle('hit',k===reached&&p<1)});
  }
  if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches){items.forEach(function(it){set(it,1)});return}
  items.forEach(function(it){set(it,0)});
  if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){items.forEach(function(it){if(it.c===e.target)it.vis=e.isIntersecting})})},{threshold:.2});cards.forEach(function(c){io.observe(c)})}
  else items.forEach(function(it){it.vis=true});
  var CYC=6200,RUN=4200;
  function ease(x){return x<.5?2*x*x:1-Math.pow(-2*x+2,2)/2}
  function f(ts){
    items.forEach(function(it){if(!it.vis)return;var t=(ts+CYC-it.off)%CYC;set(it,t<RUN?ease(t/RUN):1)});
    requestAnimationFrame(f);
  }
  requestAnimationFrame(f);
})();
document.querySelectorAll('[data-topic]').forEach(function(a){a.addEventListener('click',function(){var s=document.getElementById('f-topic');if(s)s.value=a.dataset.topic})});
</script>


</body></html>