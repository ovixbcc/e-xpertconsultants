          <div class="proc"><span class="proc-k">Process we automate</span><div class="proc-row"><div class="pt"><span class="pf"></span><span class="pdot"></span></div><ol><li>Farm</li><li>Collect</li><li>Store</li><li>Market</li></ol></div></div>
        </article>
        <article class="field f-ecom" style="--c:var(--blue)">
          <span class="ico"><svg viewBox="0 0 48 48"><g class="cart"><path d="M6 10h5l5 20h20l4-14H14"/><circle class="w" cx="19" cy="37" r="3"/><circle class="w" cx="33" cy="37" r="3"/></g><rect class="box" x="21" y="12" width="8" height="8" rx="1.5"/></svg></span>
