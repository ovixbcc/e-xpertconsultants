<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>e-Xpert Consultants</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500&family=Figtree:wght@300;400;500&display=swap">
<style>
/* Layout: airy white page, one ice-blue band per section rhythm; hero pairs a light headline with the brand's infinity loop as the delivery cycle. */
:root{
  --bg:#FFFFFF;
  --bg-soft:#F3F8FF;
  --ice:#E3EFFD;
  --ink:#16202D;
  --ink-soft:#5B6779;
  --line:#DCE7F4;
  --blue:#1584F7;
  --blue-deep:#0B63C4;
  --sky:#7CC4FF;
  --on-blue:#FFFFFF;
  --ok:#12A06A;
  --star:#F5B400;
  --c1:#1584F7;--c2:#0E5DB8;--c3:#3B6FE0;--c4:#0796C9;--c5:#0B4A93;--c6:#2E9BFF;
  --warn:#D9820B;
  --warn-soft:#FFF4E2;
  --ok-soft:#E3F6EE;
  --display:"Outfit","Segoe UI",system-ui,sans-serif;
  --body:"Figtree","Segoe UI",system-ui,sans-serif;
  --wrap:1160px;
}
/* Always light: the brand look is white + light blue, regardless of the viewer's dark mode. */
:root,:root[data-theme="dark"]{color-scheme:light}

*{box-sizing:border-box}
body{margin:0}img{max-width:100%}[hidden]{display:none!important}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-weight:300;font-size:1.0625rem;line-height:1.7;-webkit-font-smoothing:antialiased}
a{color:inherit}
h1,h2,h3{font-family:var(--display);font-weight:300;line-height:1.15;margin:0;text-wrap:balance;letter-spacing:-.01em}
p{margin:0}
.wrap{max-width:var(--wrap);margin-inline:auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
.eyebrow{font-family:var(--display);font-size:.78rem;font-weight:500;letter-spacing:.22em;text-transform:uppercase;color:var(--blue)}
.lede{color:var(--ink-soft);max-width:60ch}
:focus-visible{outline:2px solid var(--blue);outline-offset:3px;border-radius:4px}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:.5em;font-family:var(--display);font-weight:400;font-size:.95rem;letter-spacing:.02em;padding:.8em 1.5em;border-radius:999px;text-decoration:none;border:1px solid transparent;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
.btn-primary{background:var(--blue);color:var(--on-blue)}
.btn-primary:hover{background:var(--blue-deep)}
.btn-ghost{border-color:var(--line);color:var(--ink)}
.btn-ghost:hover{border-color:var(--blue);color:var(--blue)}

/* header */
header.site{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-block:14px}
.logo{display:block;color:var(--blue);line-height:0}
.logo svg{height:34px;width:auto}
.nav ul{display:flex;gap:28px;list-style:none;margin:0;padding:0}
.nav ul a{text-decoration:none;font-family:var(--display);font-size:.92rem;font-weight:400;color:var(--ink-soft)}
.nav ul a:hover{color:var(--blue)}
.nav .btn{padding:.6em 1.2em;font-size:.88rem}
@media (max-width:860px){.nav ul{display:none}}

/* hero */
.hero{padding-block:clamp(56px,9vw,112px) clamp(48px,7vw,88px);background:linear-gradient(180deg,var(--bg) 0%,var(--bg-soft) 100%)}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(32px,5vw,72px);align-items:center}
.hero-grid>*{min-width:0}
.hero h1{font-size:clamp(2.4rem,5.4vw,4.3rem);font-weight:200;margin-block:18px 22px}
.hero h1 b{font-weight:400;color:var(--blue)}
.hero .actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
@media (max-width:860px){.hero-grid{grid-template-columns:1fr}}

/* stats */
.stats{border-block:1px solid var(--line);background:var(--bg)}
.stats .wrap{display:grid;grid-template-columns:repeat(4,1fr)}
.stat{padding-block:30px;padding-inline:8px;text-align:center}
.stat+.stat{border-left:1px solid var(--line)}
.stat strong{display:block;font-family:var(--display);font-weight:200;font-size:clamp(2rem,3.6vw,2.8rem);color:var(--blue);font-variant-numeric:tabular-nums;line-height:1.1}
.stat span{font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft)}
@media (max-width:640px){.stats .wrap{grid-template-columns:1fr 1fr}.stat:nth-child(3){border-left:0}.stat:nth-child(n+3){border-top:1px solid var(--line)}}

/* sections */
section.block{padding-block:clamp(64px,9vw,112px)}
section.tint{background:var(--bg-soft)}
.head{display:grid;grid-template-columns:1fr 1.2fr;gap:clamp(24px,5vw,72px);align-items:end;margin-bottom:clamp(36px,5vw,56px)}
.head>*{min-width:0}
.head h2{font-size:clamp(1.9rem,3.6vw,2.9rem);margin-top:14px}
@media (max-width:760px){.head{grid-template-columns:1fr}}

/* about */
.about{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,72px)}
.about>*{min-width:0}
.about p+p{margin-top:1em}
.values{list-style:none;margin:0;padding:0;display:grid;gap:0;border-top:1px solid var(--line)}
.values li{display:grid;grid-template-columns:150px 1fr;gap:16px;padding-block:18px;border-bottom:1px solid var(--line)}
.values b{font-family:var(--display);font-weight:400;color:var(--ink)}
.values span{color:var(--ink-soft)}
@media (max-width:760px){.about{grid-template-columns:1fr}.values li{grid-template-columns:1fr;gap:2px}}

/* expertise */
.areas{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:18px;overflow:hidden}
.area{background:var(--bg);padding:30px 28px;display:flex;flex-direction:column;gap:10px;min-width:0}
.area svg{width:30px;height:30px;stroke:var(--blue);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.area h3{font-size:1.3rem}
.area p{color:var(--ink-soft);font-size:.97rem}
@media (max-width:900px){.areas{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.areas{grid-template-columns:1fr}}

/* services */
.services{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.service{display:grid;grid-template-columns:1fr 1.4fr auto;gap:clamp(16px,4vw,48px);align-items:start;padding-block:28px;border-bottom:1px solid var(--line)}
.service>*{min-width:0}
.service h3{font-size:clamp(1.3rem,2.2vw,1.65rem)}
.service p{color:var(--ink-soft)}
.tags{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end;max-width:260px}
.tag{font-size:.75rem;letter-spacing:.04em;padding:.3em .8em;border-radius:999px;background:var(--ice);color:var(--blue-deep);white-space:nowrap}
@media (max-width:860px){.service{grid-template-columns:1fr}.tags{justify-content:flex-start;max-width:none}}

/* process */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;counter-reset:s}
.step{border-top:2px solid var(--blue);padding-top:20px;min-width:0}
.step .n{font-family:var(--display);font-size:.8rem;font-weight:500;letter-spacing:.18em;color:var(--blue)}
.step h3{font-size:1.4rem;margin-block:8px 10px}
.step p{color:var(--ink-soft);font-size:.97rem}
.loopnote{margin-top:36px;color:var(--ink-soft);font-size:.95rem;display:flex;gap:10px;align-items:center}
.loopnote svg{flex:none;width:28px;height:14px;stroke:var(--blue);fill:none;stroke-width:1.6}
@media (max-width:900px){.steps{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.steps{grid-template-columns:1fr}}

/* contact */
.contact{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(28px,5vw,64px)}
.contact>*{min-width:0}
.details{list-style:none;margin:28px 0 0;padding:0;display:grid;gap:18px}
.details li{display:grid;grid-template-columns:110px 1fr auto;gap:12px;align-items:baseline;padding-bottom:18px;border-bottom:1px solid var(--line)}
.details .k{font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft)}
.details .v{font-family:var(--display);font-size:.98rem;font-weight:300;word-break:break-word;user-select:all}
.copy{font:inherit;font-size:.78rem;background:none;border:1px solid var(--line);color:var(--ink-soft);border-radius:999px;padding:.25em .8em;cursor:pointer}
.copy:hover{border-color:var(--blue);color:var(--blue)}
form{background:var(--bg);border:1px solid var(--line);border-radius:20px;padding:clamp(22px,4vw,36px);display:grid;gap:16px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media (max-width:560px){.row2{grid-template-columns:1fr}.details li{grid-template-columns:1fr auto}.details .k{grid-column:1/-1}}
label{display:grid;gap:6px;font-size:.8rem;color:var(--ink-soft)}
input,select,textarea{font:inherit;font-size:.92rem;font-weight:300;color:var(--ink);background:var(--bg-soft);border:1px solid var(--line);border-radius:12px;padding:.75em .9em;width:100%}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px var(--ice)}
textarea{min-height:120px;resize:vertical}
.formnote{font-size:.9rem;color:var(--blue-deep)}
@media (max-width:860px){.contact{grid-template-columns:1fr}}

/* footer */
footer{border-top:1px solid var(--line);padding-block:48px 36px}
.foot{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:32px}
.foot>*{min-width:0}
.foot .logo svg{height:46px}
.foot h4{font-family:var(--display);font-weight:500;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-soft);margin:0 0 12px}
.foot ul{list-style:none;margin:0;padding:0;display:grid;gap:6px;font-size:.86rem}
.foot a{text-decoration:none;color:var(--ink)}
.foot a:hover{color:var(--blue)}
.foot p{color:var(--ink-soft);font-size:.86rem;margin-top:14px;max-width:34ch}
.legal{margin-top:40px;padding-top:20px;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;font-size:.78rem;color:var(--ink-soft)}
@media (max-width:760px){.foot{grid-template-columns:1fr}}

/* hero: escrow payment flow */
.flow{background:var(--bg);border:1px solid var(--line);border-radius:22px;padding:clamp(16px,2.6vw,24px);box-shadow:0 24px 60px -30px rgba(21,132,247,.35);display:grid;gap:14px;min-width:0}
.flow-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}
.flow-top>div{min-width:0}
.flow-k{display:block;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft)}
.flow-id{display:block;font-family:var(--display);font-weight:400;font-size:1.15rem;font-variant-numeric:tabular-nums}
.flow-deal{display:block;font-size:.85rem;color:var(--ink-soft)}
.pill{display:inline-flex;align-items:center;gap:8px;font-family:var(--display);font-size:.82rem;padding:.35em .9em;border-radius:999px;background:var(--ice);color:var(--blue-deep);transition:background .3s,color .3s;white-space:nowrap}
.pill i{width:8px;height:8px;border-radius:50%;background:currentColor;animation:pulse 1.4s ease-in-out infinite}
.pill.ok{background:var(--ok-soft);color:var(--ok)}.pill.ok i{animation:none}
.pill.warn{background:var(--warn-soft);color:var(--warn)}
@keyframes pulse{50%{opacity:.25}}
.esc{width:100%;max-width:100%;height:auto;display:block;overflow:visible}
.esc-rail{fill:none;stroke:var(--line);stroke-width:2;stroke-dasharray:4 6}
.esc-arcl{font-family:var(--body);font-size:11px;fill:var(--ink-soft);text-anchor:middle;letter-spacing:.06em;opacity:.8}
.pn{font-family:var(--display);font-size:15px;font-weight:400;fill:var(--ink);text-anchor:middle}
.chip rect{fill:var(--bg-soft);stroke:var(--line);transition:fill .3s,stroke .3s}
.chip text{font-family:var(--body);font-size:11.5px;fill:var(--ink-soft);text-anchor:middle;transition:fill .3s}
.pc{fill:var(--bg);stroke:var(--line);stroke-width:2;transition:fill .3s,stroke .3s}
.pi{fill:none;stroke:var(--ink-soft);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:stroke .3s}
.party.on .pc{stroke:var(--blue);fill:var(--ice)}
.party.on .pi{stroke:var(--blue)}
.party.on .chip rect{fill:var(--ice);stroke:var(--ice)}
.party.on .chip text{fill:var(--blue-deep)}
.party.done .chip rect{fill:var(--ok-soft);stroke:var(--ok-soft)}
.party.done .chip text{fill:var(--ok)}
.party.warn .pc{stroke:var(--warn);fill:var(--warn-soft)}
.party.warn .pi{stroke:var(--warn)}
.party.warn .chip rect{fill:var(--warn-soft);stroke:var(--warn-soft)}
.party.warn .chip text{fill:var(--warn)}
.badge{opacity:0;transform-box:fill-box;transform-origin:center;transform:scale(.4);transition:opacity .3s,transform .4s cubic-bezier(.3,1.6,.5,1)}
.badge circle{fill:var(--ok);stroke:var(--bg);stroke-width:2.5}
.badge .bk{fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.badge .bx{display:none;font-family:var(--display);font-weight:500;font-size:13px;fill:#fff;text-anchor:middle}
.party.ok .badge{opacity:1;transform:scale(1)}
.party.warn .badge{opacity:1;transform:scale(1)}
.party.warn .badge circle{fill:var(--warn)}
.party.warn .badge .bk{display:none}.party.warn .badge .bx{display:block}
.vb{fill:var(--bg-soft);stroke:var(--line);stroke-width:2;transition:fill .35s,stroke .35s}
.vglow{fill:var(--blue);opacity:0;transition:opacity .4s}
.lock{fill:none;stroke:var(--ink-soft);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:stroke .3s}
.lock .kh{fill:var(--ink-soft);stroke:none}
.shackle{transition:transform .45s cubic-bezier(.3,1.5,.5,1);transform:translateY(-5px)}
.held{font-family:var(--display);font-size:14px;font-weight:400;fill:var(--ink-soft);text-anchor:middle;font-variant-numeric:tabular-nums;transition:fill .3s}
.vault.locked .vb{fill:var(--ice);stroke:var(--blue)}
.vault.locked .vglow{opacity:.12;animation:vglow 2s ease-in-out infinite}
.vault.locked .lock{stroke:var(--blue)}.vault.locked .lock .kh{fill:var(--blue)}
.vault.locked .shackle{transform:none}
.vault.locked .held{fill:var(--blue-deep)}
.vault.warn .vb{fill:var(--warn-soft);stroke:var(--warn)}
.vault.warn .vglow{fill:var(--warn)}
.vault.warn .lock{stroke:var(--warn)}.vault.warn .lock .kh{fill:var(--warn)}
.vault.warn .held{fill:var(--warn)}
.vault.done .vb{fill:var(--ok-soft);stroke:var(--ok)}
.vault.done .lock{stroke:var(--ok)}.vault.done .lock .kh{fill:var(--ok)}
@keyframes vglow{50%{opacity:.26}}
.tok{opacity:0;transition:opacity .25s}
.tok.show{opacity:1}
.coin circle{fill:var(--star);stroke:var(--bg);stroke-width:3}
.coin text{font-family:var(--display);font-size:15px;font-weight:500;fill:#5A3E00;text-anchor:middle}
.parcel rect{fill:var(--blue);stroke:var(--bg);stroke-width:3}
.parcel path{fill:none;stroke:var(--on-blue);stroke-width:2;stroke-linecap:round}
.doc rect{fill:var(--bg);stroke:var(--blue);stroke-width:2}
.doc path{fill:none;stroke:var(--blue);stroke-width:1.8;stroke-linecap:round}
.flow-event{display:flex;align-items:center;gap:10px;background:var(--bg-soft);border:1px solid var(--line);border-radius:14px;padding:12px 14px;min-height:56px;transition:background .3s,border-color .3s}
.flow-event .sys{flex:none;font-family:var(--display);font-size:.72rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--blue-deep);background:var(--ice);border-radius:8px;padding:.35em .65em}
.flow-event .msg{font-size:.95rem;color:var(--ink);min-width:0}
.flow-event.warn{background:var(--warn-soft);border-color:var(--warn-soft)}
.flow-event.warn .sys{background:var(--bg);color:var(--warn)}
.flow-event.flash{animation:flash .5s ease-out}
@keyframes flash{from{transform:translateY(4px);opacity:.3}to{transform:none;opacity:1}}
.flow-log{list-style:none;margin:0;padding:0;display:grid;gap:4px;font-size:.82rem;color:var(--ink-soft);min-height:4.4em}
.flow-log li{display:grid;grid-template-columns:96px 1fr;gap:8px;font-variant-numeric:tabular-nums}
.flow-log li b{font-weight:400;color:var(--blue)}
.flow-log li.w b{color:var(--warn)}
.flow-log li span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.flow-foot{display:grid;gap:8px}
.bar{height:4px;border-radius:4px;background:var(--ice);overflow:hidden}
.bar span{display:block;height:100%;width:0;background:var(--blue);border-radius:4px;transition:width .5s ease}
.flow-meta{display:flex;justify-content:space-between;gap:10px;font-size:.8rem;color:var(--ink-soft);font-variant-numeric:tabular-nums}
.flow-meta b{color:var(--ok);font-weight:500}
/* who we are: animated logo loop v2 */
.cycle{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(28px,5vw,64px);align-items:center}
.cycle>*{min-width:0}
.inf{width:100%;max-width:100%;height:auto;display:block;overflow:visible}
.ig1{stop-color:var(--blue-deep)}.ig2{stop-color:var(--sky)}
.ih1{stop-color:var(--ice);stop-opacity:.9}.ih2{stop-color:var(--ice);stop-opacity:0}
.inf-track{fill:none;stroke:var(--ice);stroke-width:30;stroke-linecap:round;stroke-linejoin:round}
.inf-rail{fill:none;stroke:var(--bg);stroke-width:2;stroke-dasharray:1 12;stroke-linecap:round;opacity:.9}
.inf-t{fill:none;stroke-linecap:round;stroke-linejoin:round}
.inf-t3{stroke:var(--blue);stroke-width:30;opacity:.12}
.inf-t2{stroke:var(--blue);stroke-width:30;opacity:.3}
.inf-glow{stroke:var(--sky);stroke-width:30;opacity:.55}
.inf-t1{stroke:url(#inf-grad);stroke-width:30}
.inf-eye{fill:var(--blue)}
.inf-eye-ring{fill:none;stroke:var(--blue);stroke-width:2}
.inf-run{fill:var(--bg);stroke:var(--blue-deep);stroke-width:3.5}
.inf-run-halo{fill:var(--bg);opacity:.35}
.spk{fill:var(--sky)}
.mk .disc{fill:var(--bg);stroke:var(--line);stroke-width:2;transition:fill .35s,stroke .35s}
.mk .ic{fill:none;stroke:var(--ink-soft);stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;transition:stroke .35s}
.mk .rip{fill:none;stroke:var(--blue);stroke-width:2;opacity:0}
.mk .ml{font-family:var(--display);font-size:19px;font-weight:300;fill:var(--ink-soft);text-anchor:middle;transition:fill .35s}
.mk .pop{transform-box:fill-box;transform-origin:center;transition:transform .45s cubic-bezier(.3,1.6,.5,1)}
.mk.on .pop{transform:scale(1.18)}
.mk.on .disc{fill:var(--blue);stroke:var(--blue)}
.mk.on .ic{stroke:var(--on-blue)}
.mk.on .ml{fill:var(--ink);font-weight:400}
.mk.hit .rip{animation:rip 1.1s ease-out}
.mk.hit .rip.r2{animation-delay:.25s}
.mk.on .gear{transform-box:fill-box;transform-origin:center;animation:spin 3s linear infinite}
@keyframes rip{0%{opacity:.8;r:26}100%{opacity:0;r:52}}
@keyframes spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:no-preference){.inf-eye-ring{animation:eye 2.4s ease-out infinite}}
@keyframes eye{0%{opacity:.8;r:14}100%{opacity:0;r:30}}
.stages{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.stages li{position:relative;overflow:hidden;display:grid;grid-template-columns:44px 1fr;gap:14px;padding:16px 18px;border-radius:16px;border:1px solid transparent;transition:background .35s,border-color .35s,transform .35s,box-shadow .35s}
.stages li>div{min-width:0}
.stages .sn{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-size:.8rem;font-weight:500;color:var(--blue);background:var(--ice);transition:background .35s,color .35s}
.stages h3{font-size:1.35rem;margin-bottom:4px}
.stages p{color:var(--ink-soft);font-size:.97rem}
.stages li .prog{position:absolute;left:0;bottom:0;height:3px;width:0;background:linear-gradient(90deg,var(--blue),var(--sky))}
.stages li.on{background:var(--bg);border-color:var(--line);transform:translateX(6px);box-shadow:0 18px 40px -28px rgba(21,132,247,.55)}
.stages li.on .sn{background:var(--blue);color:var(--on-blue)}
@media (max-width:860px){.cycle{grid-template-columns:1fr}.stages li.on{transform:none}}
/* major fields */
.fields{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.field{position:relative;overflow:hidden;background:var(--bg);border:1px solid var(--line);border-radius:20px;padding:26px 22px 22px;display:flex;flex-direction:column;gap:10px;min-width:0;transition:transform .3s,box-shadow .3s}
.field::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:var(--c)}
.field:hover{transform:translateY(-4px);box-shadow:0 26px 54px -34px color-mix(in srgb,var(--c) 75%,transparent)}
.field h3{font-size:1.3rem;margin-top:6px}
.field p{color:var(--ink-soft);font-size:.93rem;flex:1}
.ico{width:64px;height:64px;border-radius:18px;background:color-mix(in srgb,var(--c) 13%,var(--bg));display:grid;place-items:center}
.ico svg{width:40px;height:40px;fill:none;stroke:var(--c);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
.proc{margin-top:8px;padding:14px 0 0;border-top:1px solid var(--line)}
.proc-k{display:block;font-size:.66rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:color-mix(in srgb,var(--c) 75%,#000);margin-bottom:10px}
.proc-row{position:relative}
.pt{position:absolute;left:12.5%;right:12.5%;top:7px;height:3px;border-radius:3px;background:color-mix(in srgb,var(--c) 18%,var(--bg))}
.pf{position:absolute;left:0;top:0;bottom:0;width:calc(var(--p,1)*100%);border-radius:3px;background:var(--c)}
.pdot{position:absolute;top:50%;left:calc(var(--p,1)*100%);width:11px;height:11px;margin:-5.5px 0 0 -5.5px;border-radius:50%;background:var(--bg);border:2.5px solid var(--c);box-shadow:0 0 0 4px color-mix(in srgb,var(--c) 22%,transparent)}
.proc ol{position:relative;list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr)}
.proc li{display:flex;flex-direction:column;align-items:center;gap:6px;font-size:.7rem;line-height:1.2;text-align:center;color:var(--ink-soft);min-width:0;transition:color .3s}
.proc li::before{content:"";width:17px;height:17px;border-radius:50%;background:var(--bg);border:2px solid color-mix(in srgb,var(--c) 30%,var(--bg));transition:background .3s,border-color .3s,transform .3s}
.proc li.on{color:var(--ink)}
.proc li.on::before{background:var(--c);border-color:var(--c)}
.proc li.hit::before{transform:scale(1.25)}
@media (max-width:1100px){.fields{grid-template-columns:repeat(2,1fr)}}
@media (max-width:560px){.fields{grid-template-columns:1fr}}
.ico svg *{transform-box:fill-box}
@media (prefers-reduced-motion:no-preference){
  .f-travel .plane{animation:fly 3.2s ease-in-out infinite}
  .f-travel .trail{stroke-dasharray:4 5;animation:dash 1.2s linear infinite}
  .f-fin rect{transform-origin:50% 100%;animation:grow 2.4s ease-in-out infinite}
  .f-fin .b2{animation-delay:.25s}.f-fin .b3{animation-delay:.5s}
  .f-agro .sprout{transform-origin:50% 100%;animation:sway 3s ease-in-out infinite}
  .f-ecom .cart{animation:roll 2.8s ease-in-out infinite}
  .f-ecom .box{animation:drop 2.8s ease-in infinite}
  .f-med .pulse{stroke-dasharray:100;animation:beat 2.4s ease-in-out infinite}
  .f-estate .win{animation:light 3s steps(1) infinite}
  .f-estate .w2{animation-delay:1.5s}
  .f-bpc .spark{transform-origin:50% 50%;animation:twinkle 2s ease-in-out infinite}
  .f-bpc .s2{animation-delay:1s}
  .f-rmg .shirt{transform-origin:50% 0;animation:hang 3.4s ease-in-out infinite}
  .f-rmg .stitch{stroke-dasharray:2 3;animation:dash 1s linear infinite}
}
@keyframes fly{0%,100%{transform:translate(-2px,2px)}50%{transform:translate(3px,-3px)}}
@keyframes dash{to{stroke-dashoffset:-18}}
@keyframes grow{0%,100%{transform:scaleY(1)}50%{transform:scaleY(.55)}}
@keyframes sway{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(6deg)}}
@keyframes roll{0%,100%{transform:translateX(-2px)}50%{transform:translateX(3px)}}
@keyframes drop{0%{transform:translateY(-10px);opacity:0}25%{opacity:1}60%,100%{transform:translateY(6px);opacity:0}}
@keyframes beat{0%{stroke-dashoffset:100}55%,85%{stroke-dashoffset:0}100%{stroke-dashoffset:-100}}
@keyframes light{0%{fill:var(--c)}50%{fill:none}}
@keyframes twinkle{0%,100%{transform:scale(.4);opacity:.3}50%{transform:scale(1.15);opacity:1}}
@keyframes hang{0%,100%{transform:rotate(-4deg)}50%{transform:rotate(4deg)}}
/* services growth chart */
.growth{margin:0 0 clamp(36px,5vw,56px);background:var(--bg);border:1px solid var(--line);border-radius:22px;padding:clamp(16px,2.6vw,28px);box-shadow:0 24px 60px -34px rgba(21,132,247,.35);min-width:0}
.growth-top{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:8px}
.g-title{display:block;font-family:var(--display);font-weight:400;font-size:1.2rem}
.g-read{text-align:right}
.g-read strong{font-family:var(--display);font-weight:200;font-size:2rem;color:var(--blue);font-variant-numeric:tabular-nums;line-height:1}
.growth-scroll{overflow-x:auto}
.g-svg{width:100%;min-width:640px;height:auto;display:block}
.g-stop1{stop-color:var(--blue);stop-opacity:.22}
.g-stop2{stop-color:var(--blue);stop-opacity:0}
.g-area{fill:url(#g-fill)}
.g-line{fill:none;stroke:url(#g-stroke);stroke-width:4.5;stroke-linecap:round;stroke-linejoin:round}
.g-dot{fill:var(--bg);stroke:var(--ink);stroke-width:4}
.g-gl{stroke:var(--line);stroke-width:1}
.g-ax{font-family:var(--body);font-size:13px;fill:var(--ink-soft);text-anchor:middle;font-variant-numeric:tabular-nums}
.ph circle{fill:var(--bg);stroke:var(--line);stroke-width:2;transition:fill .3s,stroke .3s}
.ph line{stroke:var(--line);stroke-width:1;stroke-dasharray:3 4;transition:stroke .3s}
.ph text{font-family:var(--display);font-size:15px;fill:var(--ink-soft);text-anchor:middle;transition:fill .3s}
.ph.on circle{fill:var(--pc);stroke:var(--pc)}
.ph.on line{stroke:var(--pc)}
.ph.on text{fill:var(--pc)}
.ph.on text{fill:var(--ink);font-weight:400}
.g-pm{fill:color-mix(in srgb,var(--c4) 12%,var(--bg))}
.g-pmfill{fill:var(--c4);opacity:.35}
.g-pmt{font-family:var(--display);font-size:13px;fill:#05729A;letter-spacing:.03em}
.growth figcaption{margin-top:10px;font-size:.82rem;color:var(--ink-soft)}
/* reviews */
.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.review{background:var(--bg);border:1px solid var(--line);border-radius:20px;padding:26px 24px;display:flex;flex-direction:column;gap:18px;min-width:0}
.rv-top{display:flex;justify-content:space-between;align-items:center;gap:10px}
.stars{display:flex;gap:3px}
.stars svg{width:18px;height:18px;fill:var(--star);stroke:var(--star);stroke-width:1.2;stroke-linejoin:round}
.cc{font-family:var(--display);font-size:.72rem;font-weight:500;letter-spacing:.14em;color:var(--blue-deep);background:var(--ice);border-radius:999px;padding:.3em .8em}
.rv-text{font-family:var(--display);font-weight:300;font-size:1.12rem;line-height:1.55;flex:1}
.rv-who{display:flex;align-items:center;gap:12px;padding-top:16px;border-top:1px solid var(--line)}
.rv-who>div{min-width:0;display:grid}
.rv-who b{font-family:var(--display);font-weight:400}
.rv-who span{font-size:.88rem;color:var(--ink-soft)}
.av{flex:none;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:var(--ice);color:var(--blue);font-family:var(--display);font-weight:500}
.review.is-placeholder{border-style:dashed;background:var(--bg-soft)}
.review.is-placeholder .stars svg{fill:none;stroke:var(--line)}
.review.is-placeholder .rv-text,.review.is-placeholder .rv-who b{color:var(--ink-soft)}
@media (max-width:980px){.reviews{grid-template-columns:repeat(2,1fr)}}
@media (max-width:600px){.reviews{grid-template-columns:1fr}}
section[id]{scroll-margin-top:72px}
/* own products */
.products{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.product{position:relative;overflow:hidden;background:var(--bg);border:1px solid var(--line);border-radius:22px;padding:clamp(24px,3.4vw,36px);display:flex;flex-direction:column;gap:14px;min-width:0;transition:transform .3s,box-shadow .3s}
.product::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:var(--pc)}
.product:hover{transform:translateY(-4px);box-shadow:0 28px 60px -36px rgba(21,132,247,.45)}
.p-tb{--pc:linear-gradient(90deg,#0E5A9C,#1292D0,#8BD7F7)}
.p-ch{--pc:linear-gradient(90deg,#6A3FD8,#9B7BF0)}
.p-logo{height:64px;display:flex;align-items:center}
.p-logo img{max-height:56px;width:auto;max-width:100%}
.p-tag{align-self:flex-start;font-family:var(--display);font-size:.72rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--blue-deep);background:var(--ice);border-radius:999px;padding:.35em .9em}
.product h3{font-size:clamp(1.4rem,2.4vw,1.8rem)}
.product p{color:var(--ink-soft)}
.p-feat{list-style:none;margin:4px 0 8px;padding:0;display:grid;gap:8px}
.p-feat li{display:flex;gap:10px;align-items:baseline}
.p-feat li::before{content:"";flex:none;width:8px;height:8px;border-radius:50%;background:var(--blue);transform:translateY(-1px)}
.p-link{align-self:flex-start;margin-top:auto}
.p-link svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
@media (max-width:860px){.products{grid-template-columns:1fr}}
.p-db{--pc:linear-gradient(90deg,#0B4A93,#1584F7,#7CC4FF);grid-column:1/-1;display:grid;grid-template-columns:1fr 1.15fr;gap:clamp(24px,4vw,48px);align-items:start}
.db-main{display:flex;flex-direction:column;gap:14px;min-width:0;height:100%}
.db-logo{height:64px;display:flex;align-items:center;gap:12px}
.db-mark svg{width:46px;height:46px;display:block}
.db-word{font-family:var(--display);font-size:1.9rem;font-weight:300;color:var(--ink);letter-spacing:-.01em}
.db-word b{font-weight:500;color:var(--blue)}
.db-tags{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.db-new{font-family:var(--display);font-size:.72rem;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--on-blue);background:var(--blue);border-radius:999px;padding:.35em .9em}
.db-steps{list-style:none;margin:4px 0 8px;padding:0;display:grid;gap:8px}
.db-steps li{display:flex;gap:10px;align-items:center;font-size:.95rem}
.db-steps b{flex:none;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-size:.75rem;font-weight:500;background:var(--ice);color:var(--blue-deep)}
.db-feat{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.db-feat li{display:flex;gap:12px;align-items:flex-start;padding:14px;border-radius:16px;background:var(--bg-soft);border:1px solid var(--line);min-width:0;transition:border-color .25s,background .25s}
.db-feat li:hover{border-color:var(--blue);background:var(--bg)}
.db-feat li>div{min-width:0;display:grid;gap:2px}
.db-feat b{font-family:var(--display);font-weight:400;font-size:.98rem}
.db-feat span:not(.db-i){font-size:.84rem;color:var(--ink-soft);line-height:1.5}
.db-i{flex:none;width:38px;height:38px;border-radius:11px;background:var(--ice);display:grid;place-items:center}
.db-i svg{width:21px;height:21px;fill:none;stroke:var(--blue);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
@media (max-width:980px){.p-db{grid-template-columns:1fr}}
@media (max-width:520px){.db-feat{grid-template-columns:1fr}}

/* leadership */
.leaders{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.leader{background:var(--bg);border:1px solid var(--line);border-radius:22px;padding:clamp(22px,3vw,30px);display:flex;flex-direction:column;gap:16px;min-width:0;transition:transform .3s,box-shadow .3s}
.leader:hover{transform:translateY(-4px);box-shadow:0 28px 60px -36px rgba(21,132,247,.45)}
.l-top{display:flex;align-items:center;gap:16px}
.l-top>div{min-width:0}
.l-av{flex:none;width:80px;height:80px;border-radius:50%;object-fit:cover;display:grid;place-items:center;font-family:var(--display);font-size:1.3rem;font-weight:400;letter-spacing:.04em;color:var(--on-blue);background:linear-gradient(135deg,var(--sky),var(--blue) 55%,var(--blue-deep));box-shadow:0 0 0 5px var(--ice)}
.leader h3{font-size:1.3rem}
.l-role{display:block;font-size:.78rem;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--blue)}
.leader p{color:var(--ink-soft);font-size:.95rem;flex:1}
.l-link{display:inline-flex;align-items:center;gap:6px;align-self:flex-start;font-family:var(--display);font-size:.88rem;color:var(--blue-deep);text-decoration:none;padding-top:14px;border-top:1px solid var(--line);width:100%}
.l-link:hover{color:var(--blue)}
.l-link svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
@media (max-width:980px){.leaders{grid-template-columns:1fr 1fr}}
@media (max-width:640px){.leaders{grid-template-columns:1fr}}
/* services: animated cards */
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.svc{position:relative;overflow:hidden;background:var(--bg);border:1px solid var(--line);border-radius:22px;padding:22px 22px 26px;display:flex;flex-direction:column;gap:12px;min-width:0;transition:transform .3s,box-shadow .3s}
.svc::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:var(--c)}
.svc:hover{transform:translateY(-4px);box-shadow:0 28px 60px -36px color-mix(in srgb,var(--c) 70%,transparent)}
.svc-viz{background:color-mix(in srgb,var(--c) 7%,var(--bg));border-radius:16px;padding:14px 14px 10px;margin-bottom:6px}
.svc-viz svg{width:100%;height:auto;display:block;overflow:visible}
.svc h3{font-size:1.25rem}
.svc p{color:var(--ink-soft);font-size:.95rem;flex:1}
.svc .tags{justify-content:flex-start;max-width:none}
.svc .tag{background:color-mix(in srgb,var(--c) 13%,var(--bg));color:color-mix(in srgb,var(--c) 72%,#000)}
.svc-note{margin-top:14px;font-size:.82rem;color:var(--ink-soft)}
.vt{font-family:var(--display);font-size:12px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;fill:color-mix(in srgb,var(--c) 75%,#000)}
.vl,.lg text,.wk text,.q text{font-family:var(--body);font-size:11.5px;fill:var(--ink-soft)}
.wk text,.q text{text-anchor:middle}
.wk path{stroke:color-mix(in srgb,var(--c) 18%,var(--bg));stroke-width:1}
.vbig{font-family:var(--display);font-size:20px;font-weight:400;fill:var(--ink);text-anchor:middle}
.trk{fill:none;stroke:color-mix(in srgb,var(--c) 12%,var(--bg))}
.trk2{fill:color-mix(in srgb,var(--c) 12%,var(--bg))}
.seg{fill:none;stroke-width:18;stroke-dasharray:var(--v) 100}
.sbar,.col,.shrink{transform-box:fill-box}
.sbar{transform-origin:left center}
.col{transform-origin:center bottom}
.shrink{transform-origin:left center}
.tick{fill:#3B6FE0;stroke:var(--bg);stroke-width:2;transform-box:fill-box;transform-origin:center}
.up{fill:none;stroke:#0E5DB8;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.today rect{fill:#05729A}.today circle{fill:#05729A}
.base{stroke:color-mix(in srgb,var(--c) 25%,var(--bg));stroke-width:1.5}
.trend{fill:none;stroke:#062F63;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:100}
.gtrk,.gval{fill:none;stroke-width:16;stroke-linecap:round}
.gtrk{stroke:color-mix(in srgb,var(--c) 14%,var(--bg))}
.gval{stroke:#2E9BFF;stroke-dasharray:88 100}
.needle{stroke:var(--ink);stroke-width:3;stroke-linecap:round;transform-origin:84px 118px;transform:rotate(68deg)}
.hub{fill:var(--ink)}
.vbig + .vl{}
@media (prefers-reduced-motion:no-preference){
  .svc.play .seg{animation:sv-donut 7s ease-out infinite;animation-delay:var(--dl)}
  .svc.play .sbar{animation:sv-x 7s cubic-bezier(.2,.8,.2,1) infinite;animation-delay:var(--dl)}
  .svc.play .col{animation:sv-y 7s cubic-bezier(.2,.8,.2,1) infinite;animation-delay:var(--dl)}
  .svc.play .tick{animation:sv-pop 7s ease-out infinite;animation-delay:var(--dl)}
  .svc.play .up{stroke-dasharray:80;animation:sv-draw80 7s ease-out infinite;animation-delay:var(--dl)}
  .svc.play .trend{animation:sv-draw 7s ease-out infinite;animation-delay:var(--dl)}
  .svc.play .today{animation:sv-today 7s linear infinite}
  .svc.play .gval{animation:sv-gauge 7s cubic-bezier(.2,.8,.2,1) infinite}
  .svc.play .needle{animation:sv-needle 7s cubic-bezier(.2,.8,.2,1) infinite}
  .svc.play .shrink{animation:sv-shrink 7s cubic-bezier(.2,.8,.2,1) infinite}
}
@keyframes sv-donut{0%{stroke-dasharray:0 100}30%,88%{stroke-dasharray:var(--v) 100}100%{stroke-dasharray:0 100}}
@keyframes sv-x{0%{transform:scaleX(0)}30%,88%{transform:scaleX(1)}100%{transform:scaleX(0)}}
@keyframes sv-y{0%{transform:scaleY(0)}30%,88%{transform:scaleY(1)}100%{transform:scaleY(0)}}
@keyframes sv-pop{0%,20%{transform:scale(0)}30%{transform:scale(1.3)}36%,88%{transform:scale(1)}100%{transform:scale(0)}}
@keyframes sv-draw{0%,10%{stroke-dashoffset:100}40%,88%{stroke-dashoffset:0}100%{stroke-dashoffset:100}}
@keyframes sv-draw80{0%,10%{stroke-dashoffset:80}35%,88%{stroke-dashoffset:0}100%{stroke-dashoffset:80}}
@keyframes sv-today{0%{transform:translateX(0)}90%,100%{transform:translateX(204px)}}
@keyframes sv-gauge{0%{stroke-dasharray:0 100}35%,88%{stroke-dasharray:88 100}100%{stroke-dasharray:0 100}}
@keyframes sv-needle{0%{transform:rotate(-90deg)}35%,88%{transform:rotate(68deg)}100%{transform:rotate(-90deg)}}
@keyframes sv-shrink{0%{transform:scaleX(4.4)}35%,88%{transform:scaleX(1)}100%{transform:scaleX(4.4)}}
@media (max-width:1000px){.svc-grid{grid-template-columns:1fr 1fr}}
@media (max-width:620px){.svc-grid{grid-template-columns:1fr}}
</style>


